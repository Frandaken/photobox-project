# --- Konfigurasi SMB (NAS) ---
SMB_ADDRESS=//192.168.1.10/photobox-share
SMB_USERNAME=photobox
SMB_PASSWORD=ganti-dengan-password-asli
SMB_DOMAIN=WORKGROUP
# Subfolder DI DALAM share di atas tempat semua hasil foto disimpan.
# Dibuat otomatis kalau belum ada. Kosongkan untuk simpan di root share.
SMB_UPLOAD_DIR=hasil-foto

# --- Admin Panel ---
# PIN untuk membuka Admin Panel (gembok pojok kanan atas di kios).
# WAJIB diisi -- kalau kosong, Admin Panel akan menolak semua akses.
ADMIN_PIN=123456

# --- Server ---
PORT=3001
# Folder di dalam container untuk menyimpan data Layout & Background
# yang diedit lewat Admin Panel. Mount sebagai volume Docker supaya
# perubahan admin tidak hilang saat container di-rebuild.
DATA_DIR=/app/data
