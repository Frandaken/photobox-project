# --- Admin & Server ---
PORT=3000
# Admin PIN for Photobox Admin Panel (default: 1234)
ADMIN_PIN=1234
# Directory for storing layouts, backgrounds, and local photos
DATA_DIR=./data

# --- SMB NAS Configuration ---
# Alamat share SMB (format Windows \\ip\share atau Linux //ip/share)
SMB_ADDRESS=\\192.168.15.18\photobox-share
SMB_USERNAME=server
SMB_PASSWORD=server
SMB_DOMAIN=WORKGROUP
SMB_UPLOAD_DIR=

# --- Nextcloud WebDAV Configuration (Opsional) ---
# Base URL instance Nextcloud (tanpa trailing slash)
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_UPLOAD_FOLDER=NAS/PHOTOBOX
