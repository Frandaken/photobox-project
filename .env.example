# --- Application & Server ---
PORT=5795
NODE_ENV=production
APP_URL=http://192.168.15.18:8010

# --- Photobox Admin & Storage ---
ADMIN_PIN=1234
DATA_DIR=/app/data

# --- Nextcloud WebDAV & Public Share Configuration ---
# Alamat URL Nextcloud (contoh: https://nextcloud.abipraya.id atau http://192.168.1.100:8080)
NEXTCLOUD_URL=https://nextcloud.abipraya.id
NEXTCLOUD_USERNAME=photobox

# PENTING: Gunakan App Password khusus dari Nextcloud (bukan password akun biasa)
# Buka Nextcloud > Pengaturan Pribadi > Keamanan > Perangkat & sesi > Buat sandi aplikasi baru
NEXTCLOUD_APP_PASSWORD=ganti-dengan-app-password

# Folder target penyimpanan di Nextcloud
NEXTCLOUD_UPLOAD_FOLDER=NAS/PHOTOBOX

# Jika Nextcloud menggunakan SSL/HTTPS lokal mandiri (self-signed cert), hilangkan tanda komentar (#):
# NODE_TLS_REJECT_UNAUTHORIZED=0
