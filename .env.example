# --- Application & Server ---
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:8080

# --- Photobox Admin & Storage ---
ADMIN_PIN=1234
DATA_DIR=./data

# --- Nextcloud WebDAV & Public Share Configuration ---
# Base URL Nextcloud (contoh: https://nextcloud.abipraya.id)
NEXTCLOUD_URL=https://nextcloud.abipraya.id
NEXTCLOUD_USERNAME=photobox
# Disarankan membuat App Password khusus di Nextcloud (Settings > Security > Devices & sessions)
NEXTCLOUD_APP_PASSWORD=ganti-dengan-app-password
# Folder dasar penyimpanan di Nextcloud
NEXTCLOUD_UPLOAD_FOLDER=NAS/PHOTOBOX
